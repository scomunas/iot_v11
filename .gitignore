# ==============================================================================
# IoT Automation System - Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Secrets & Environment Variables
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
backend/.venv/
backend/venv/

# Pytest & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.cover
*.pyo

# ------------------------------------------------------------------------------
# SQLite Databases & Storage
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/db/*.db
backend/db/*.db-journal
backend/db/*.db-wal
backend/db/*.db-shm

# ------------------------------------------------------------------------------
# Node.js & Angular Frontend
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
.angular/
frontend/.angular/
frontend/dist/
dist/
out-tsc/
bazel-out/

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
backend/logs/
logs/
*.log.*

# Generated Task Outputs & Scratch Scripts
backend/output/
output/
scratch/

# Testing reports
coverage/
frontend/coverage/
.vitest/

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# IDEs & Code Editors
# ------------------------------------------------------------------------------
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.classpath
.settings/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
